# Copy to .env and fill in. Never commit .env. Only OPENROUTER_API_KEY is required.
OPENROUTER_API_KEY=
# Optional: Jev auth for local dev (otherwise `vercel env pull` provides VERCEL_OIDC_TOKEN)
AI_GATEWAY_API_KEY=
# Optional overrides (defaults in app/config.py)
# ANSWER_MODEL=google/gemini-2.5-flash
# ROUTER_MODE=jev            # or model_only (benchmark)
# SAVE_TURNS=1               # 0 disables conversation storage (evals set this)
# RATE_LIMIT_PER_MINUTE=12
# RATE_LIMIT_PER_DAY=200
# SUPABASE_URL=...           # the publishable, insert-only key has a default in config.py
# SUPABASE_PUBLISHABLE_KEY=...
# Never put a Supabase service-role key here: nothing needs it.
